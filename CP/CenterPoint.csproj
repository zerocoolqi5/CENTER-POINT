<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CenterPoint-Transfer</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>13.8.0</Version>
    <AssemblyVersion>13.8.0.0</AssemblyVersion>
    <FileVersion>13.8.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <ItemGroup>
    <!-- Update (not Include) — ملفات ui مُضمّنة افتراضياً كـ None؛ نضبط النسخ فقط لتفادي التكرار -->
    <None Update="ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- تضمين واجهة الويب داخل الـexe ليكون مكتفياً بذاته (يعمل التحديث التلقائي الذي ينشر exe فقط) -->
    <EmbeddedResource Include="ui\index.html" />
  </ItemGroup>
</Project>
